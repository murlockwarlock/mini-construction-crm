server {
  listen 80;
  listen [::]:80;
  server_name __SITE_DOMAIN__;
  root __APP_DIR__/current;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store";
  }
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
}
